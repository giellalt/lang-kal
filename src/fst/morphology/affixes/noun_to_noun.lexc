LEXICON GEMS !!= * @CODE@ = Gennemgangsleksikon til nominer der geminerer til stop-lyd ved fleksion, fx meeqqap
 Z1Zmorf ;
0:^GEMS tp_infl ; !!= * @CODE@

LEXICON GEMC
0:^GEMC tp_infl_noposs ;

LEXICON Z1Zmorf !!= * @CODE@ Derivationsmorfemer til nominer, viser til **tp** og giver derefter nn-derivationer
!!= * @CODE@ obs 20200623: fleksionsmorfemgrænse er %< og ikke %>
< "@C.riartoq@" > common_noun_to_noun_suffixes ; !Z1Zmorf_nn_suffixes
tp ;

LEXICON tp !!= * @CODE@ obs 20200623: fleksionsmorfemgrænse er %< og ikke %>
< "@C.Loan.i@" > common_verbalizers ;
< "@C.Loan.i@" > weak_stem_specific_verbalizers ;
 tp_infl ;

!#### tpt
LEXICON tptmorf !!= * @CODE@ 
 +ARAQ+Der/nn+Err/Sub:%>ivaraq Z1_qaZmorf ; !qallunaaqqat
 +LIAQ+Der/nn+Err/Sub:%>iliaq tp ;
 +SUAQ+Der/nn+Err/Sub:%>ersuaq Z2aqZ ; !bør ændres fra Err/Sub
 0:i2 common_noun_to_noun_suffixes ;
 tpt ;
 +Err/Sub+N+Abs+Sg:%>eq Krestr ; 
 +Err/Sub+N+Abs+Sg+1SgPoss:%>era Krestr ;
LEXICON tpt !!= * @CODE@ 
@P.schwa.ON@0:@P.schwa.ON@i2 common_verbalizers ; !tpt_verbalizers
0:i2 speciffic_for_schwa_stem_verbalizers ;
tpt_inflections ;
