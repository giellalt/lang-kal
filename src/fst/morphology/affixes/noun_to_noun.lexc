LEXICON common_noun_to_noun_suffixes ! FÆLLES leksikon, tidligere Z1Zmorf_nn_suffixes omstruktureret
0:^T%> truncative_noun_to_noun ;
0:%> additive_noun_to_noun ;
0:%> recessive_noun_to_noun ;
+LIK+Der/nn: lik_nn ; ! Z2_lZ

LEXICON truncative_noun_to_noun
+ALUK+Der/nn+ARAQ+Der/nn:aluaraq Z1_qaZmorf ; !!=	* @CODE@
+ALUK+Der/nn+INNAQ+Der/nn+NNGUAQ+Der/nn:aluinnannguaq Z1nnguaqZmorf ; !!	* ... osv.
+ALUK+Der/nn+INNAQ+Der/nn+SUAQ+Der/nn:aluinnarsuaq Z2aqZ ;
+ALUK+Der/nn+INNAQ+Der/nn+VIK+Der/nn+SUAQ+Der/nn:aluinnavissuaq Z2aqZ ;
+ALUK+Der/nn+INNAQ+Der/nn+VIK+Der/nn:aluinnavik tup- ;
+ALUK+Der/nn+INNAQ+Der/nn:aluinnaq tup- ; !!= 	* @CODE@
+ALUK+Der/nn+KASIK+Der/nn:alukasik tup- ;
+ALUK+Der/nn+KUQ+Der/nn:alukoq tp ;
+ALUK+Der/nn+LIK+Der/nn+RUJUK+Der/nn+SUAQ+Der/nn:alulerujussuaq Z2aqZ ;
+ALUK+Der/nn+LIK+Der/nn+SUAQ+Der/nn:alulissuaq Z2aqZ ;
+ALUK+Der/nn+LIK+Der/nn+TAQ+Der/nn:alulittaq tp ;
+ALUK+Der/nn+LIK+Der/nn:alu Z2_lZ ;
+ALUK+Der/nn+MINIQ+Der/nn:alumineq Z2_rZmorf ;
+ALUK+Der/nn+NNGUAQ+Der/nn+ARAQ+Der/nn:alunnguaaraq Z1_qaZmorf ;
+ALUK+Der/nn+NNGUAQ+Der/nn+INNAQ+Der/nn:alunnguaannaq tup- ;
+ALUK+Der/nn+NNGUAQ+Der/nn+KULUK+Der/nn:alunnguakkuluk tup- ;
+ALUK+Der/nn+NNGUAQ+Der/nn:alunnguaq Z1nnguaqZmorf ;
+ALUK+Der/nn+PAK@U.Num.Pl@+Der/nn+ALUK+Der/nn+SUAQ+Der/nn:aluppaalussuaq@U.Num.Pl@ Z2aqZ ;
+ALUK+Der/nn+PAK@U.Num.Pl@+Der/nn+ALUK+Der/nn:aluppaaluk@U.Num.Pl@ tup- ;
+ALUK+Der/nn+PAK@U.Num.Pl@+Der/nn+SUAQ+Der/nn:aluppassuaq@U.Num.Pl@ Z2aqZ ;
+ALUK+Der/nn+PAK@U.Num.Pl@+Der/nn+SUAQ+Der/nn:aluppassuaq@U.Num.Pl@ Z2aqZ ;
+ALUK+Der/nn+PAK@U.Num.Pl@+Der/nn:aluppak@U.Num.Pl@ tup- ;
