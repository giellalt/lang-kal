!# FJERNEDE SUFFIKSER - I BRUG VED BESTEMTE STAMMER, MEN IKKE PRODUKTIVE #!
!# skal sættes ind i noun.lexc v/relevante stammer                       #!
!#########################################################################!
!#                                                                       #!
!+ATSIAQ+Der/nn+NNGUAQ+Der/nn:atsiannguaq Z1nnguaqZmorf ;                #!
!+ATSIAQ+Der/nn+SSAQ+Der/nn:atsiassaq tp ;                               #!
!+ATSIAQ+Der/nn+SUAQ+Der/nn:atsiarsuaq Z2aqZ ;                           #!
!+ATSIAQ+Der/nn:atsiaq Z2aqZ ;                                           #!
