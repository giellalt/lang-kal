!#########################################################
!# NYT SAMLET LEKSIKON FOR VERBALISERENDE SUFFIKSER 2026 #
!#########################################################

LEXICON ZtiZ_verbalizers
+GASAAR+Der/nv:%>rasaar IV_long_stem ;
+GIIAAR+Der/nv:%>giiaar IV_long_stem ;
+LUP+Der/nv:%>lup lup_nv ; !IV_k_stem
 common_verbalizers ;

LEXICON GIIT_verbalizers
+GASAAR+Der/nv:^T%>rasaar IV_long_stem ;
 common_verbalizers ;

LEXICON ZkkutZ_verbalizers
+GASAAR+Der/nv:^T%>rasaar IV_long_stem ;
 common_verbaalizers ;

!#CHECKLIST:
!# +GIP
!# +IAR
!# +LIR
!# +LIRSUR
!# +LUP
!# +Orth/Youth
!# +Use/-Spell

!LEXICON verbalizers !renamed, earlier LEXICON tp_verbalizers
!< "@C.stærkstamme@" "@C.qtor@" > common_verbalizers ;
!< "@R.aqstamme.ON@" > strong_aq_stem_specific ;
!< "@R.svagstamme.ON@" > weak_stem_specific_verbalizers ;
!< "@R.stærkstamme.ON@" > strong_stem_specific_verbalizers ;
!< "@R.schwa.ON@" > speciffic_for_schwa_stem_verbalizers ;
!< "@R.gtokk.ON@" > speciffic_for_gtokk_stem_verbaizers ; ! gtokk as in g geminates to kk
!+IAR+Der/nv:^T%>ajar iar_tv ; !HTR_r_GAQ_i !@D.schwa.ON@
!+IAR+Der/nv:^T%>iar iar_tv ; !HTR_r_GAQ_i !@D.schwa.ON@


LEXICON common_verbalizers
@C.qtor@@C.nnguaq@@C.aqstamme@0:@C.qtor@@C.nnguaq@@C.aqstamme@^T%> truncative_verbalizers ;
@C.qtor@@C.nnguaq@@C.aqstamme@0:@C.qtor@@C.nnguaq@@C.aqstamme@%> additive_verbalizers ;
@C.qtor@@C.nnguaq@@C.aqstamme@0:@C.qtor@@C.nnguaq@@C.aqstamme@%> recessive_verbalizers ;
@D.qtor.ON@@D.nnguaq.ON@@D.aqstamme.ON@+U+Der/nv:@D.qtor.ON@@D.nnguaq.ON@@D.aqstamme.ON@^T%>u copula_nv ; !IV_voq !
+U+Der/nv+TUQ+Der/vn+N+Abs+Pl+1Pl:^T%>usugut K_plur ; !PL20230918 typen innuttaasugut som subjekt og objekt !@D.nnguaq.ON@@D.aqstamme.ON@

LEXICON qtor_specific_verbalizer
!#
+IAR+Der/nv:^T%>ajar iar_tv ; !HTR_r_GAQ_i !@D.schwa.ON@
+IAR+Der/nv:^T%>iar iar_tv ; !HTR_r_GAQ_i !@D.schwa.ON@
!#
+U+Der/nv:%>u copula_nv ; !IV_voq !@R.qtor.ON@@D.nnguaq.ON@@D.aqstamme.ON@

LEXICON nnguaq_specific_verbalizer
!#
+IAR+Der/nv:^T%>ajar iar_tv ; !HTR_r_GAQ_i !@D.schwa.ON@
+IAR+Der/nv:^T%>iar iar_tv ; !HTR_r_GAQ_i !@D.schwa.ON@
!#
+U+Der/nv:^VCT%>u copula_nv ; !IV_voq

LEXICON strong_aq_stem_specific_verbalizers
+GASAAR+Der/nv:^T%>rasaar IV_long_stem ;
!#
+IAR+Der/nv:^T%>ajar iar_tv ; !HTR_r_GAQ_i !@D.schwa.ON@
+IAR+Der/nv:^T%>iar iar_tv ; !HTR_r_GAQ_i !@D.schwa.ON@
!#
@D.aak.ON@+LUP+Der/nv:@D.aak.ON@^T%>lup lup_nv ; !IV_k_stem
+U+Der/nv:^VCT%>u copula_nv ; !IV_voq !NB gammel form med trunkeret -aq

LEXICON weak_stem_specific_verbalizers
+GASAAR+Der/nv:%>gasaar IV_long_stem ;
@D.aak.ON@+LUP+Der/nv:@D.aak.ON@%>lup lup_nv ; !IV_k_stem
+GIIAAR+Der/nv:^T%>giiaar IV_long_stem ;
!#
+IAR+Der/nv:^T%>ajar iar_tv ; !HTR_r_GAQ_i !@D.schwa.ON@
+IAR+Der/nv:^T%>iar iar_tv ; !HTR_r_GAQ_i !@D.schwa.ON@
!#

LEXICON strong_stem_specific_verbalizers
+GASAAR+Der/nv:^T%>rasaar IV_long_stem ;
+GIIAAR+Der/nv:%>g2iiaar IV_long_stem ;
!#
+IAR+Der/nv:^T%>ajar iar_tv ; !HTR_r_GAQ_i !@D.schwa.ON@
+IAR+Der/nv:^T%>iar iar_tv ; !HTR_r_GAQ_i !@D.schwa.ON@
!#


LEXICON speciffic_for_schwa_stem_verbalizers
@C.schwa@+IAR+Der/nv:@C.schwa@^VT%>aajar HTR_r_GAQ_i ;
!+U+Der/nv:^VT%>aa copula_nv ; !IV_voq
@C.schwa@+U+Der/nv+Orth/Alt+Use/-Spell:@C.schwa@^T%>^u copula_nv ; !IV_voq !livm 20170525 til 'ikiortiuvoq'

LEXICON speciffic_for_gtokk_stem_verbaizers
!+LIR+Der/nv:^VCT%>ker IV_r_stem ;
!#
+IAR+Der/nv:^T%>ajar iar_tv ; !HTR_r_GAQ_i !@D.schwa.ON@
+IAR+Der/nv:^T%>iar iar_tv ; !HTR_r_GAQ_i !@D.schwa.ON@
!#
@D.repl.OFF@+LIR+Der/nv+Gram/repl:@D.repl.OFF@^VCT%>ker HTR_r_GAQ_i ; !nammakkerpaa
!@U.lirsur.ON@@U.vip.OFF@+LIRSUR+Der/nv:@U.lirsur.ON@@U.vip.OFF@^VCT%>kersor IV_r_stem ;
@D.repl.OFF@@U.lirsur.ON@@U.vip.OFF@+LIRSUR+Der/nv+Gram/repl:@D.repl.OFF@@U.lirsur.ON@@U.vip.OFF@^VCT%>kersor HTR_r_GAQ_i ;


LEXICON truncative_verbalizers
+GISSAAR+Der/nv+Orth/Alt+Use/-Spell:gissaar IV_r_stem ; !siunissagissaarnissaat
+ILATSI+Der/nv:ilatsi IV_voq ;
+ILIQI+Der/nv:ileqi IV_voq ;
+IRNIAR+Der/nv:erniar IV_r ; !PL 20190312 nyt morfem. IR+IV uden NIAR vist altid passiv
+IRSIR+Der/nv:erser irsir_iv ; ! XIirXmorf_stem
+IRUTE+Der/nv:erup irute_iv ; ! XIuteXmorf
+IRUTE+Der/nv:erup irute_tv ; ! HTR_UTE_SSAQ_ssi
+KIP+Der/nv:kip XItsXmorf_stem ;
+KILLI+Der/nv:killi XIi_voqXmorf_stem ;
+KKAAR+Der/nv:kkaar kkaar_tv ; ! HTR_longV_GAQ_addi
+KKAAR+Der/nv:kkaar IV_r_stem ; !Jude 20231017
+KKUMINAR+Der/nv:kkuminar IV_r_stem ;
+KKUUTAAR+Der/nv:kkuutaar flex-tv ; !liv 170403 til ord som 'napparsimasukkuutaarlugu'
+LIAR+Der/nv:liar liar_iv ; !IV_r_UTE_gennemgang
+LIKKIRSAAR+Der/nv:likkersaar IV_long_stem ;
+LIR+Der/nv:ler lir_iv ; !XIirXmorf_stem
+LIR+Der/nv+Gram/truncative:ler lir_tv ; !HTR_ir_GAQ_i
+LIRI+Der/nv:leri liri_iv ; ! XIi_voqXmorf
+LIRSUR+Der/nv:lersor lirsur_iv ; ! IV_r_UTE_gennemgang
+LIRSUR+Der/nv:lersor lirsur_tv ; ! TV_UTE_gennemgang
+LISAAR+Der/nv:lisaar IV_r_stem ;
+LISAR+Der/nv:lisar IV_r_stem ;
+LIUR+Der/nv:lior liur_iv ; ! IV_r_stem
+LIUR+Der/nv+UTE+Der/vv:liuup liuup_tv ; ! HTR_UTE_SSAQ_ssi
@C.Num@+LIUTE+Der/nv:@C.Num@liup HTR_UTE_SSAQ_ssi ;
@C.Num@+LLIR+Der/nv:@C.Num@ller XIirXmorf_stem ;
@R.qimmeq.ON@@R.aak.ON@+LUP+Der/nv:@R.qimmeq.ON@@R.aak.ON@lup lup_nv ; !IV_k_stem
@R.seq.ON@@D.oqaq.ON@+LUP+Der/nv+Err/Sub:@R.seq.ON@@D.oqaq.ON@lup lup_nv ; !IV_k_stem, @R.seq.ON@ som i SEQgemin, ZseqZ
@D.aak.ON@@D.oqaq.ON@+LUP+Der/nv:@D.aak.ON@@D.oqaq.ON@lup lup_nv ; !IV_k_stem
+NIP+Der/nv:nip nip_iv ; !IV_k
+NGA+Der/nv:nga nga_nv ; !IV_voq
+NNAP+Der/nv:nnap nnap_nv ; !IV_k
+NNGIR+Der/nv:nnger nngir_nv ; !XIirXmorf_stem
+NNGUAQ+Der/nn+GE+Der/nv+Gram/TV+GALUAQ+Der/vn:nnguarigaluaq   GEGALUAQ ;
+NNGUR+Der/nv:nngor nngur_iv ; ! @C.Num@ IV_r_UTE_gennemgang !PL 20180201 Nyt gennemgangskatalog
+NNGUR+Der/nv:nngor nngur_tv ; !@C.Num@ HTR_r_GAQ_i
+SSAQ+Der/nn+LIUR+Der/nv:ssior IV_r_UTE_gennemgang ; !PL 20200623 SSAQ=LIUR medtaget utraditionelt for at tillade fusionen 
+QAR+Der/nv:qar qar_nv ; !IV_r_stem
+QQURTU+Der/nv:qqortu IV_voq_stem ;
+QQURTUSI+Der/nv:qqortusi XIi_voqXmorf ;
@U.rsur.ON@+RSUR+Der/nv:@U.rsur.ON@rsor IV_r_stem ; !PL2021 qarsaasiarsorpoq
@U.rsur.ON@+RSUR+Der/nv:@U.rsur.ON@rsor HTR_r_GAQ_i ; !Ondi 20230217 erinarsorpaa
+SIUR+Der/nv+Orth/Arch+Use/-Spell:sior IV_r_stem ;
+SSAQQIP+Der/nv:ssaqqip XIiXmorf_stem ;
+SSIP+Der/nv:ssip IV_k ;
@R.qimmeq.ON@+TAAR+Der/nv:@R.qimmeq.ON@taar IV_r ;
@D.vowelstem.ON@+TUR+Der/nv+Orth/Youth+Use/-Spell:@D.vowelstem.ON@tor tur_iv ; ! IV_r !naasutorpoq for naasortorpoq
@U.assibileretT.OFF@+TUR+Der/nv:@U.assibileretT.OFF@tor tur_iv ; ! IV_r !former m/truncative +TUR+Der/nv, men som ikke er +Use/-Spell: ikiaroornartutorpoq, imakutorpoq, for at forebygge generering af: *ikiaroornartortorpoq, *ikiaroornartorsorpoq
@U.assibileretT.ON@+TUR+Der/nv:@U.assibileretT.ON@sor tur_iv ;
@U.usaar.ON@+USAAR+Der/nv:@U.usaar.ON@usaar IV_r_stem ;

LEXICON additive_verbalizers
+GE+Der/nv:g2i2 ge_nv ; !HTR_schwa_SAQ_nnip
+GE+Der/nv+Gram/TV+GALUAQ+Der/vn:g2igaluaq GEGALUAQ ;
+GIP+Der/nv:g2ip gip_nv ; ! XIiXmorf_stem
+GISSAAR+Der/nv:g2issaar IV_r_stem ;
@U.Num.Pl@+GIIP+Der/nv+Gram/Reci:@U.Num.Pl@g2iip giip_nv ; !XIiXmorf_stem
@U.Boole.On@+GUP+Der/nv:@U.Boole.On@g2up IV_k_stem ; !Boole forhindrer *mamakujuttoruppoq
@R.oqaq.ON@+LUP+Der/nv:@R.oqaq.ON@lup IV_k_stem ;
+SI+Der/nv:si si_nv ; ! XIi_voqXmorf
+SIUR+Der/nv:sior IV_r ;
+SIUR+Der/nv+UTE+Der/vv@U.saar.OFF@:@U.saar.OFF@siuup HTR_UTE_SSAQ_ssi ;
+SUNNIP+Der/nv:sunnip IV_k ;
+SUNNIP+Der/nv:sunnip XItsX ;
@D.qimmeq.ON@+TAAR+Der/nv:@D.qimmeq.ON@taar IV_r ;
+TAAR+Der/nv+Orth/Youth+Use/-Spell:rtaar IV_r ;
+TU+Der/nv:tu tu_iv ; ! IV_voq
@C.Num@@U.Tur.Off@+TUR+Der/nv:@C.Num@@U.Tur.Off@tor tur_iv ; ! IV_r
@C.Num@@U.Tur.On@+TUR+Der/nv:@C.Num@@U.Tur.On@sor tur_iv ; ! IV_r
@C.Num@+TUR+Der/nv+GUMA+Der/vv:@C.Num@tuuma IV_r ; !241019 PN. Ved ikke om det er i orden sådan.

LEXICON recessive_verbalizers !recessive consonant appears when suffixed to vowel stems
+PALLAP+Der/nv:r2pallap IV_k ;
+PALAAQ+Der/vn+U+Der/nv:r2palaa IV_voq ; !For at faa baade palaavoq og palaajuvoq
+PALAAR+Der/nv:r2palaar IV_r_stem ;
+PALUP+Der/nv:r2palup IV_k ;
+PASIP+Der/nv:r2pasip pasip_nv ; !IV_k !qinngorpasinnerusoq


!##########!
!# Der/nv #!
!##########!

LEXICON copula_nv
< "@C.aqstamme@" "@C.nnguaq@" "@C.qtor@" "@U.alup.OFF@" "@U.ja.OFF@" "@U.nar.OFF@" "@U.nga.OFF@" "@U.qqar.OFF@" "@U.saar.OFF@" "@U.umi.OFF@" "@U.copula.ON@" > IV_voq ;

LEXICON ge_nv
< "@U.saar.OFF@" "@U.ge.ON@" > HTR_schwa_SAQ_nnip ;

LEXICON giip_nv
< "@U.giip.ON@" "@U.Num.Pl@" > XIiXmorf_stem ;

LEXICON gip_nv
< "@U.iar.OFF@" "@U.niaq.OFF@" "@U.gip.ON@" > XIiXmorf_stem ;

LEXICON iar_tv ! +IAR+Der/nv
< "@U.iar.ON@" > HTR_r_GAQ_i ;
! noun stem +IAR+Der/nv not to be combined with suffix indicated in OFF flag in stem
!malinnaaviaqineqarlutik

LEXICON irsir_iv 
< "@U.irsir.ON@" > XIirXmorf_stem ;

LEXICON irute_iv
< "@U.saar.OFF@" > XIuteXmorf ;

LEXICON irute_tv
< "@U.saar.OFF@" > HTR_UTE_SSAQ_ssi ;

LEXICON kkaar_tv
< "@U.Num.Pl@" > HTR_longV_GAQ_addi ;

LEXICON liar_iv
< "@U.usiq.OFF@" > IV_r_UTE_gennemgang ;

LEXICON lir_tv
< "@U.ja.OFF@" "@U.qqa.OFF@" "@U.qqar.OFF@" "@U.tirtv.OFF@" "@U.usiq.OFF@" "@U.lirtv.ON@" > HTR_ir_GAQ_i ;

LEXICON lir_iv
< "@U.liriv.ON@" "@U.usiq.OFF@" > XIirXmorf_stem ;

LEXICON liri_iv
< "@U.liri.ON@" > XIi_voqXmorf ;

LEXICON lirsur_iv
< "@C.Num@" "@U.lirsur.ON@" > IV_r_UTE_gennemgang ;

LEXICON lirsur_tv
< "@C.Num@" "@U.lirsur.ON@" > TV_UTE_gennemgang ;

LEXICON liur_iv
< "@C.Num@" > IV_r_stem ;

LEXICON liuup_tv
< "@C.Num@" "@U.saar.OFF@" > HTR_UTE_SSAQ_ssi ;

LEXICON lup_nv
< "@C.Num@" "@U.lup.ON@" > IV_k_stem ;

LEXICON nar_tv
< "@U.Boole.On@" > IV_r ;

LEXICON nga_nv
< "@U.utevn.OFF@" "@U.nganv.ON@" "@U.saar.OFF@" > IV_voq ;

LEXICON nnap_nv
< "@U.nnap.ON@" > IV_k ;

LEXICON nngir_nv 
< "@U.umi.OFF@" "@U.nngir.ON@" > XIirXmorf_stem ;

LEXICON nngur_tv ! +NNGUR+Der/nv
< "@C.Num@" "@U.qe.OFF@" "@U.alup.OFF@" "@U.nip.ON@" "@U.nngur.ON@" > HTR_r_GAQ_i ;
!malinnaavinnguineqarlutik

LEXICON nngur_iv
< "@C.Num@" "@U.nngur.ON@" > IV_r_UTE_gennemgang ;

LEXICON nip_iv ! +NIP+Der/nv
< "@U.qe.OFF@" "@U.alup.OFF@" "@U.nip.ON@" > IV_k ;
!malinnaaffinialugit
!tunngavilersuutineqineqarneri

LEXICON pasip_nv
< "@U.pasipnv.ON@" > IV_k ;

LEXICON qar_nv
< "@C.Num@" "@U.nar.OFF@" "@U.nga.OFF@" "@U.usar.OFF@" > IV_r_stem ;

LEXICON si_nv 
< "@U.ja.OFF@" "@U.sinv.ON@" > XIi_voqXmorf ;

LEXICON tu_iv ! +TU+Der/nv
< "@U.tu.ON@" > IV_voq_stem ;

LEXICON tur_iv
< "@C.Num@" "@U.tur.ON@" > IV_r_stem ;
