!Kontinuationer
!-----------------------|-------------------|---------------|
!Gram_Hyb_UR:			|	Der_1_efter_UR:	|	Der_2_n		|
!-----------------------|-------------------|---------------|---------------|---------------|
!(Gram_Hyb_UR_gramtag)	| 	Der_1_vn		|	Der_2_nn	|				|				|
!						|					|---------------|---------------|---------------|
!						|					|	Der_2_nv_IV	| Der_3_IV_vn	|	Der_4_nn	|
!						|					|				| Der_3_IV_vv	|				|
!						|					|---------------|---------------|---------------|
!						|					|	Der_2_nv_TV	| Der_3_TV_vv	|				|
!						|-------------------|---------------|---------------|---------------|
!						|					|	Der_2_v		| Der_3_n		|				|
!						|					|---------------|---------------|---------------|
!						|	Der_1_vv		|	Der_2_vn	| Der_3_nv_IV	|				|
!						|					|				| Der_3_nn		|				|
!-----------------------|-------------------|---------------|---------------|---------------|

!Angående flags @P og @R:
!P or Positive (Re)Setting, @P.feature.value@:
!Sets or resets the feature to the given value.
!R or Require Test, @R.feature.value@:
!For this diacritic, a test is performed, 
!and it succeeds iff feature is currently set to value, 
!otherwise the path is blocked.
!D or Disallow Test, @D.feature.value@:
!A test is performed that succeds if feature is neutral 
!or set to a value that is incompatible with value.
!https://giellalt.github.io/lang-sme/docu-sme-flag-diacritics.html


LEXICON Gram_Hyb_UR !!= * @CODE@ 
+Gram/Hyb+UR+Der/nv@C.Num@@U.umi.OFF@@U.ur.ON@:@C.Num@@U.umi.OFF@@U.ur.ON@^T%>or Gram_Hyb_UR_gramtag ;

LEXICON Gram_Hyb_UR_gramtag
+Gram/IV:0 Der_1_efter_UR ;
+Gram/IV:0 flex_iv_r2_inflections ;
+Gram/TV:0 flex_tv2_inflections ;

LEXICON Der_1_efter_UR
Der_1_vn ; 
Der_1_vv ; 

LEXICON Der_1_vn
@P.niq.ON@+NIQ+Der/vn:@P.niq.ON@%>neq Der_2_n ;
+NIQ+Der/vn:%>neq tup_inflections ;

@P.qatevn.ON@@P.giitnn.ON@+QATE+Der/vn:@P.qatevn.ON@@P.giitnn.ON@^T%>qati2 Der_2_n ;
@P.giitnn.ON@+QATE+Der/vn:@P.giitnn.ON@^T%>qati2 tpt_inflections ;

+SSUSIQ+Der/vn:^T%>ssuseq Der_2_n ;
+SSUSIQ+Der/vn:^T%>ssuseq ZseqZ_inflections ;

+TUQ+Der/vn:%>toq Der_2_n ;
+TUQ+Der/vn:%>toq tp_infl ;

LEXICON Der_2_n
Der_2_nn ;
Der_2_nv_IV ;
@R.qatevn.ON@ Der_2_nv_TV ;

LEXICON Der_2_nn
@R.niq.ON@+SSAQ+Der/nn:@R.niq.ON@^T%>ssaq tp_infl ;

LEXICON Der_2_nv_IV
+QAR+Der/nv:^T%>qar Der_3_IV_vn ;
+QAR+Der/nv:^T%>qar flex_iv_r2_inflections ;
+U+Der/nv:^T%>u Der_3_IV_vv ; !'arnanoortuunngilanga'
+U+Der/nv:^T%>u flex_iv_voq2_inflections ;

LEXICON Der_3_IV_vv
+NNGIT+Der/vv:^T%>nngi flex_iv_nngit2_inflections ; !'arnanoortuunngilanga'

LEXICON Der_2_nv_TV
+GE+Der/nv+Gram/TV:%>gi2 flex_tv_schwa2_inflections ;
+GE+Der/nv+Gram/TV:%>gi2 Der_3_TV_vv ; !IV_suffixes_vn_nv_TV_suf

LEXICON Der_3_TV_vv
+TAR+Der/vv+Gram/TV:%>sar flex_tv2_inflections ;

LEXICON Der_3_IV_vn
@P.niq.ON@+NIQ+Der/vn:@P.niq.ON@%>neq Der_4_nn ;
+NIQ+Der/vn:%>neq tup_inflections ;

LEXICON Der_4_nn
@R.niq.ON@+SSAQ+Der/nn:@R.niq.ON@^T%>ssaq tp_infl ;


LEXICON Der_1_vv
+LIR+Der/vv+Gram/IV:^T%>ler Der_2_v ;
+LIR+Der/vv+Gram/IV:^T%>ler XIiX2_inflections ;

+QQAAR+Der/vv+SINNAA+Der/vv+NNGIT+Der/vv+Gram/IV:^T%>qqaarsinnaanngi Der_2_v ;
+QQAAR+Der/vv+SINNAA+Der/vv+NNGIT+Der/vv+Gram/IV:^T%>qqaarsinnaanngi flex_iv_nngit2_inflections ;

+RIAR+Der/vv+Gram/IV:^T%>riar Der_2_v ;
+RIAR+Der/vv+Gram/IV:^T%>riar flex_iv2_inflections ;

+SIMA+Der/vv+LIR+Der/vv:%>simaler Der_2_v ;
+SIMA+Der/vv+LIR+Der/vv:%>simaler XIiX2_inflections ;

+SSA+Der/vv+Gram/IV:^T%>ssa Der_2_v ;
+SSA+Der/vv+Gram/IV:^T%>ssa flex_iv_ssa2_inflections ;

+SSA+Der/vv+GUNAR+Der/vv+Gram/IV:^T%>ssagunar Der_2_v ;
+SSA+Der/vv+GUNAR+Der/vv+Gram/IV:^T%>ssagunar flex_iv2_inflections ;

+TAR+Der/vv+Gram/IV:%>tar Der_2_v ;
+TAR+Der/vv+Gram/IV:%>tar flex_iv_r2_inflections ;

+TARIAQAR+Der/vv+Gram/IV:%>tariaqar Der_2_v ;
+TARIAQAR+Der/vv+Gram/IV:%>tariaqar flex_iv2_inflections ;

+TIP+Der/vv:tip Der_2_v ;
@U.nominalizers.OFF@+TIP+Der/vv:@U.nominalizers.OFF@tip flex-tv ; 

LEXICON Der_2_v
Der_2_vn ;

LEXICON Der_2_vn
@P.niq.ON@+NIQ+Der/vn:@P.niq.ON@%>neq Der_3_n ;
+NIQ+Der/vn:%>neq tup_inflections ;

+TUQ+Der/vn:%>toq Der_3_n  ;
+TUQ+Der/vn:%>toq tp_infl ;

LEXICON Der_3_n
Der_3_nn ;
Der_3_nv_IV ;

