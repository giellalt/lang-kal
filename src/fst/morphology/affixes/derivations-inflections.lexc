LEXICON Naalsuf !!= * @CODE@ livm 20171211 tilføjet pluralisbøjning
 indholds-K ;
+QAR+Der/nv:%>qar IV_r_stem ;
+LIK+Der/nn:%> Z2_lZ ; !tb-lik
+Abs+Sg+3SgPoss@U.acro.poss.epent.v@@C.acro.norm@:va@U.acro.poss.epent.v@@C.acro.norm@ # ;
+Rel+Sg+3SgPoss@U.acro.poss.epent.v@@C.acro.norm@:vata@U.acro.poss.epent.v@@C.acro.norm@ # ;
+Trm+Sg+3SgPoss@U.acro.poss.epent.v@@C.acro.norm@:vanut@U.acro.poss.epent.v@@C.acro.norm@ # ;
+Abl+Sg+3SgPoss@U.acro.poss.epent.v@@C.acro.norm@:vanit@U.acro.poss.epent.v@@C.acro.norm@ # ;
+Ins+Sg+3SgPoss@U.acro.poss.epent.v@@C.acro.norm@:vanik@U.acro.poss.epent.v@@C.acro.norm@ # ;
+Trm+Sg+3PlPoss@U.acro.poss.epent.v@@C.acro.norm@:vannut@U.acro.poss.epent.v@@C.acro.norm@ # ;
+Lok+Sg+3PlPoss@U.acro.poss.epent.v@@C.acro.norm@:vanni@U.acro.poss.epent.v@@C.acro.norm@ # ;
+Abs+Pl+3SgPoss@U.acro.poss.epent.v@@C.acro.norm@:vi@U.acro.poss.epent.v@@C.acro.norm@ # ;
+Abs+Pl+3PlPoss@U.acro.poss.epent.v@@C.acro.norm@:vi@U.acro.poss.epent.v@@C.acro.norm@ # ;
+Abl+Pl+3SgPoss@U.acro.poss.epent.v@@C.acro.norm@:vinit@U.acro.poss.epent.v@@C.acro.norm@ # ;
+Ins+Pl+3SgPoss@U.acro.poss.epent.v@@C.acro.norm@:vinik@U.acro.poss.epent.v@@C.acro.norm@ # ;
+Rel+Sg:p  Krestr ;
+Lok+Sg:mi  LokVb ;
+Lok+Pl:ni LokVb ;
+Trm+Sg:mut TrmVb ;
+Trm+Pl:nut TrmVb ;
+Abl+Sg:mit AblVb ;
+Abl+Pl:nit AblVb ;
+Abl+Sg:miit Krestr ;
+Abl+Pl:niit Krestr ;
+Abl+Sg:minngaanniit Krestr ;
+Abl+Pl:ninngaanniit Krestr ;
+Via:kkut ViaVb ;
+Aeq:tut AeqVb ;
+Ins+Sg:mik Krestr ;
+Ins+Pl:nik Krestr ;

