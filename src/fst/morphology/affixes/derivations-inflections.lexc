LEXICON N_Loan_ACR_morf !!= - @CODE@ Derivationsmorfemer til akronymer som BMW, IT etc. som er nominale og kan bøjes
 N_Loan_ACR_infl ;  !!= 	 - @CODE@ !PL20240511 nyt fortsættelseslex

LEXICON N_Loan_ACR_infl !NY PL220240511 fleksion til akronymer som IT og BMW, der er rigtige nominer
+LIRI@C.Num@+Der/nv:^T%>leri@C.Num@ XIi_voqXmorf ;
@U.Num.Sg@@U.DemPron.Sg@+N+Abs+Sg:@U.Num.Sg@@U.DemPron.Sg@ Krestr_ACR ; !tp
@U.Num.Pl@@U.DemPron.Pl@+N+Abs+Pl:@U.Num.Pl@@U.DemPron.Pl@^T%<t K_plur ; !tp !obs 20200623: fleksionsmorfemgrænse er %< og ikke %>
@C.Num@+QAR+Der/nv:@C.Num@^T%>qar IV_r_stem ;
+R+Der/nv:%>r IV_r ;

LEXICON Krestr_ACR
+LU:%>lu # ;


!######################!
!# spell flag section #!
!######################!
!20241113
!blocking suffix combinations to filter out suggestions from spellchecker
!iv_ means Der/vv that attaches to intransitive stem
!_tv means Der/nv suffix that forms transitive stem

!##########!
!# Der/vv #!
!##########!

LEXICON htr_i
< "@C.ObjNum@" "@U.nga.OFF@" "@U.tiriv.OFF@" > XIi_voqXmorf ;

LEXICON iv_gunar
< "@U.gunartuq.ON@" "@U.vvik.OFF@" "@U.niaq.OFF@" "@U.nikuq.OFF@" "@U.niq.OFF@" > IV-mod_C ;

LEXICON tv_gunar
< "@U.gunartuq.ON@" "@U.vvik.OFF@" "@U.nikuq.OFF@" "@U.niaq.OFF@" "@U.niq.OFF@" > Gaq ;

LEXICON iv_gunnair
< "@U.gunnaarfik.ON@" > IV-mod_iC ;

LEXICON iv_alup ! +ALUP+Der/vv
< "@U.alup.ON@" > flex-iv ;
!malinnaaffinialugit
!arnaualuppoq

LEXICON iv_ja 
< "@U.imp.OFF@" "@U.utevn.OFF@" "@U.ja.ON@" > IV-mod_V ;

LEXICON iv_lir !+Der/vv
< "@U.usiq.OFF@" "@U.vip.OFF@" > XIiX ;
!punngavilersuutigineqarneri

LEXICON iv_nnip
< "@U.ja.OFF@" > IV_k ;

LEXICON iv_vinngit
< "@U.vinnginniq.OFF@" > IV-mod_nngit ;
!malinnaavinnginneqarlutik

LEXICON iv_qe ! +QE+Der/vv
< "@U.niq.OFF@" "@U.qe.ON@" > IV-mod_qe ; !### SEQUENCE of flags matters: blocker flag first, otherwise we block what we don't mean to block, example "amerlaqaat" ###!
< "@U.niq.OFF@" "@U.qe.ON@" > flex-iv_schwa ;
! intransitive stem +QE+Der/vv not to be combined with suffix indicated in OFF flag
!malinnaaviaqineqarlutik

LEXICON passiv_niqar
< "@C.ObjNum@" "@U.nar.OFF@" "@U.usar.OFF@" > IV_r ;

LEXICON saar_tv
< "@U.saar.ON@" > HTR_longV_GAQ_addi ;

LEXICON tv_qe ! +QE+Der/vv
< "@U.niq.OFF@" "@U.qe.ON@" > TV-mod_qe ;

LEXICON tv_rar
< "@U.rar.ON@" > Gaq ;

LEXICON tv_riar
< "@U.riar.ON@" > Gaq ;

LEXICON tv_sar
< "@U.Boole.On@" "@U.sar.ON@" > DOTR_IV_r ; ! LEXICON TV -> DOTR_IV_r 

LEXICON iv_ssa
< "@U.niaq.OFF@" > IV-mod_ssa ;

LEXICON tv_ssa
< "@U.niaq.OFF@" > TV-mod_ssa ;
!sammiumassaniaat

LEXICON ssaar_vv
< "@U.tu.OFF@" "@U.tur.OFF@" > IV-mod_C ;

LEXICON tv_tip 
< "@C.Num@" "@U.tip.ON@" "@U.suar.OFF@" > HTR_C_TAQ_tsi ;

LEXICON tv_tir
< "@U.tirtv.ON@" > post_Gaq_addi ;

LEXICON iv_vip
< "@U.vip.ON@" > IV-mod_iC ;
!punngavilersuutigineqarneri


!##########!
!# Der/nv #!
!##########!
!20260412 moved to file: src/fst/morphology/affixes/noun_to_verb.lexc


!##########!
!# Der/vn #!
!##########!
LEXICON innaq_vn
< "@U.ssaq.OFF@" "@U.innaq.ON@" > Z2_qZmorf ;

LEXICON niaq_vn
< "@U.ge.OFF@" "@U.giip.OFF@" "@U.gip.OFF@" "@U.kuq.OFF@" "@U.lik.OFF@" "@U.lup.OFF@" "@U.niaq.ON@" "@U.poss.OFF@" > Z1Zmorf ;
!sammiumassaniaat
!naleqqukkunnaarniakuupput

LEXICON niq_vn ! +NIQ+Der/vn
< "@C.Num@" "@U.araq.OFF@" "@U.kkuluk.OFF@" "@U.kkut.OFF@" "@U.kujuk.OFF@" "@U.kuluk.OFF@" "@U.kuq.OFF@" "@U.vinnginniq.RM@" "@U.nip.ON@" "@U.niq.ON@" > Z2Zmorf ; ! 
!malinnaavinnginneqarlutik

LEXICON niute_vn
< "@C.Num@" "@U.niute.ON@" > tptmorf ;

LEXICON rlaaq_vn 
< "@U.rsur.OFF@" "@U.rlaaq.ON@" > Z1Zmorf ;

LEXICON sinnaaq_vn ! +SINNAAQ+Der/vn
< "@U.ssaq.OFF@" > Z1Zmorf ;
!atorneqarsinnaassangalluarami
!"taama" IP Der/nv Gram/IV SINNAAQ Der/vn SSAQ Der/nn NGA Der/nv Gram/IV TIP Der/vv

LEXICON vik_vn
< "@C.Num@" "@U.gunnaarfik.ON@" "@U.kkut.OFF@" "@U.kuq.OFF@" "@U.vvik.ON@" > Z2_Zmorf ;

LEXICON iv_sir
< "@U.sir.ON@" > Gaq ;

LEXICON tuq_vn
< "@C.Num@" "@C.nar@" "@C.nga@" "@U.irsir.OFF@" "@U.gunartuq.ON@" "@U.riartoq.ON@" "@U.tuq.ON@" "@U.assibileretT.OFF@" > 1Pl_gennemgang ; ! Z1Zmorf
!"@C.nar@" pga:
!dette skal væk (U+NAR)
!tapiliunaq	tapeq+LIK+Der/nn+U+Der/nv+Gram/IV+NAR+Der/vv+V+Ind+Gram/Exclm	0.000000
!tapiliunaq	tapi+LIK+Der/nn+U+Der/nv+Gram/IV+NAR+Der/vv+V+Ind+Gram/Exclm	0.000000
!men dette beholdes (NAR og U efterfølgende)
!siooranartuusoq	sioora+Gram/IV+NAR+Der/vv+Gram/IV+TUQ+Der/vn+U+Der/nv+Gram/IV+TUQ+Der/vn+N+Abs+Sg	0.000000
!siooranartuusoq	sioora+Gram/IV+NAR+Der/vv+Gram/IV+TUQ+Der/vn+U+Der/nv+Gram/IV+V+Par+3Sg	0.000000
!@C.nga@
!ikke QAR+NGA men NGA+(TUQ)+QAR

LEXICON tuuq_vn 
< "@U.Boole.On@" "@U.tuuq.ON@" > Z1Zmorf ; 

LEXICON ute_vn
< "@C.Num@" "@U.usaar.OFF@" "@U.utenn.OFF@" "@U.utevn.ON@" > tptmorf ;

LEXICON iv_tur
< "@U.turvv.ON@" > Gaq ;
