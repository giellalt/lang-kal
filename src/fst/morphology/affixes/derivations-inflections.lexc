LEXICON N_Loan_ACR_morf !!= - @CODE@ Derivationsmorfemer til akronymer som BMW, IT etc. som er nominale og kan bøjes
 N_Loan_ACR_infl ;  !!= 	 - @CODE@ !PL20240511 nyt fortsættelseslex

LEXICON N_Loan_ACR_infl !NY PL220240511 fleksion til akronymer som IT og BMW, der er rigtige nominer
+LIRI@C.Num@+Der/nv:^T%>leri@C.Num@ XIi_voqXmorf ;
@U.Num.Sg@@U.DemPron.Sg@+N+Abs+Sg:@U.Num.Sg@@U.DemPron.Sg@ Krestr_ACR ; !tp
@U.Num.Pl@@U.DemPron.Pl@+N+Abs+Pl:@U.Num.Pl@@U.DemPron.Pl@^T%<t K_plur ; !tp !obs 20200623: fleksionsmorfemgrænse er %< og ikke %>
@C.Num@+QAR+Der/nv:@C.Num@^T%>qar IV_r_stem ;
+R+Der/nv:%>r IV_r ;

LEXICON Krestr_ACR
+LU:%>lu # ;


!######################!
!# spell flag section #!
!######################!
!20241113
!blocking suffix combinations to filter out suggestions from spellchecker
!iv_ means Der/vv that attaches to intransitive stem
!_tv means Der/nv suffix that forms transitive stem

!##########!
!# Der/vv #!
!##########!

LEXICON htr_i
< "@C.ObjNum@" "@U.nga.OFF@" "@U.tiriv.OFF@" > XIi_voqXmorf ;

LEXICON iv_gunar
< "@U.gunartuq.ON@" "@U.vvik.OFF@" "@U.niaq.OFF@" "@U.nikuq.OFF@" "@U.niq.OFF@" > IV_mod_C ;

LEXICON tv_gunar
