  !#.   #  #.    #  #.  #  #
  !#.   #. #     #. #.  #. #
  !#.    ##     ####.    ##

! lav begrænsninger til:
!INTRANSITIVERNE
!+NIR+Der/vv	XIiPX_fleksiver3
!+NIR+Der/vv	XIiPX2_inflections
!+NIR+Der/vv	XIiX_fleksiver3
!+QINA+Der/vv	flex_iv_qina
!+V+Imp+2Pl:%<gisi K_TUQ_plur ; !fra XIiPX_fleksiver  versus GI+V+Imp+2Pl 
!TRANSITIVERNE
!tjek oqalunguser+UTE+Der/vv+Gram/TV+V+Ind+3Sg+4SgO+Orth/Arch+Use/SpellNoSugg i regressionen: flex_tv2_ute_inflections
!+NIR+Der/vv	flex_tvP_fleksiver2
!+2Pl+3SgO:%<gisiuk K_TUQ ; ! se +GI atorluarisiuk
!+2Sg+3SgO:%<giuk K_TUQ ; !se +GI nassiukkiuk
!qinaare+V+Imp+2Sg+3SgO	qinaaruuk flex_tv_scwha2_inflections
!+NNGIT transitive +Opt
!giuk 2p subj, 1p subj? B p 56 bunden
!+QE+Der/vv plus IteCau?? XTPX_schwa_inflections
!keeriar+SSA+Der/vv+V+Opt+1Pl+2SgO. flex_tv_ssa_inflections

!######################!
!# INTRANSITIVE VERBS #!
!######################!

!IV_voq_stem 				-> flex_iv_voq2_inflections
!XIi_voqXmorf_stem			-> flex_iv_voq2_inflections
!XIi_voqX_agentiv 			-> flex_iv_voq kun 2 medlemmer, forskel: bare +Gram/HV
!XIuteXmorf 				-> flex_iv2_inflections schwa stamme (uti2)
!IV_k_stem 					-> flex_iv2_inflections
!XIitX_stem (IV_it_stem) 	-> flex_iv2_inflections
!XItX 						-> flex_iv2_inflections        t stammer

!XIiXmorf_stem 				-> XIiX2_inflections          intransitiv stamme, ender på iC: blanding af t og k stammer med i før finalkonsonant 
!XItsXmorf_stem 			-> XItsX3 ender på privativ IT og har formen tsoq ved Par
!IV_r_stem 					-> flex_iv_r2_inflections     
!XIirXmorf_stem 			-> XIiX_fleksiver3
!IV_long_stem 				-> flex_iv_long2_inflections
!IV_long 					-> flex_iv_long2_inflections
!IVschwa 					-> flex_iv_schwa2_inflections

!CHECKLIST ADDED TO REGRESSIONTEST
!LEXICON flex_iv_voq2_inflections + LEXICON flex_iv_voq2_2P_subject 

!########################################################!
!# FÆLLES FLEKSIONSLEKSIKA FOR INTRANSITIVE VERBER 2026 #!
!########################################################!

LEXICON intransitive_inflections !flex_iv_voq2_inflections
@U.Num.Pl@+V+Der/Vok+2Pl:@U.Num.Pl@%<t3usiaa K_plur ; !flex_iv
!overordnede modi
< "@D.negation.ON@" > Ind_itr ;
< "@R.negation.ON@" > Ind_itr_AFT_negation ; !after negation +NNGIT+Der/vv

< "@U.imp.ON@" > Imp_mood_itr ;

< "@D.negation.ON@" > Int_mood_itr ;
< "@R.negation.ON@" > Int_itr_AFT_negation ; !after negation +NNGIT+Der/vv

Opt_mood_itr ;
!underordnede modi
+V+IteCau:%<gaanga IteCau_itr_pers_num ;
+V+Cau:%<ga Cau_itr_pers_num ;
+V+Cau:%<c2ma Cau_Con_itr_3p_pers_num ;

+V+Con:%<gu Con_itr_pers_num ;
+V+Con:%<c2pa Cau_Con_itr_3p_pers_num ;

Cont_itr ;

+V+Par:%<t3u verb_itr_pers_num ;
@U.Num.Sg@+V+Par+4Sg:@U.Num.Sg@%<gaanni K ; !flex_iv

LEXICON Ind_itr
+V+Ind:%<v2u verb_itr_pers_num ;
+V+Ind+1Du:%<v2uguk K ; !trænger til gennemtjek

LEXICON Ind_itr_AFT_negation
+V+Ind:^T%<la verb_itr_pers_num ;

LEXICON Imp_mood_itr
< "@U.Num.Sg@" > Imp_mood_itr_singular ;
< "@U.Num.Pl@" > Imp_mood_itr_plural ;
LEXICON Imp_mood_itr_singular
+V+Imp+2Sg:%<g2it K_TUQ ; !+Gram/ImpPos
@R.schwa.ON@+V+Imp+2Sg:@R.schwa.ON@%<g4it K_TUQ ;
@D.vowelstem.ON@+V+Imp+2Sg:@D.vowelstem.ON@%<nak K_TUQ ; !+Gram/ImpNeg [ SKAL undersøges hvorfor vokalstammerne ikke har den, når andre modusleksika har den ]
@D.vowelstem.ON@@D.schwa.ON@+V+Imp+2Sg:@D.vowelstem.ON@@D.schwa.ON@%<na K_TUQ ;
LEXICON Imp_mood_itr_plural
+V+Imp+1Pl:%<t3a K_TUQ_plur ;
+V+Imp+2Pl:%<gisi K_TUQ_plur ; !fra XIiPX_fleksiver 
+V+Imp+2Pl:%<g2itsi K_TUQ_plur ;
+V+Imp+2Pl+NNGUUJUIT:%<g2itsinnguujuit # ; !flex_iv NNGUUJUK anvendt som tilhængspartikel. Kun dokumenteret efter Imp

LEXICON Int_mood_itr
< "@U.Num.Sg@" > Int_mood_itr_singular ;
< "@U.Num.Pl@" > Int_mood_itr_plural ;
LEXICON Int_mood_itr_singular
+V+Int+2Sg:%<v2it K ;
+V+Int+2Sg+Orth/Alt:%<v2iit K ; !+Orth/Alt
+V+Int+3Sg:%<v2a K ;
LEXICON Int_mood_itr_plural
+V+Int+1Pl:%<v2ugut K_plur ;
+V+Int+2Pl:%<v2isi K_plur ;
+V+Int+3Pl:%<v2at K_plur ;

LEXICON Int_itr_AFT_negation
< "@U.Num.Sg@" > Int_itr_negation_singular ;
< "@U.Num.Pl@" > Int_itr_negation_plural ;
LEXICON Int_itr_negation_singular
+V+Int+2Sg:^T%<latit K ;
+V+Int+3Sg:^T%<la K ;
LEXICON Int_itr_negation_plural
+V+Int+2Pl:^T%<lasi K_plur ;
+V+Int+3Pl:%<lat K_plur ;

LEXICON Opt_mood_itr
< "@U.Num.Sg@" > Opt_mood_itr_singular ;
< "@U.Num.Pl@" > Opt_mood_itr_plural ;
!+Opt+1Sg:%<naanga K_TUQ ; !+Orth/Arch+Use/SpellNoSugg DANNER mærkelige former
!+Opt+1Pl:%<naagut K_TUQ ; !+Orth/Arch+Use/SpellNoSugg DANNER mærkelige former

LEXICON Opt_mood_itr_singular
+V+Opt+1Sg:%<langa K_TUQ ;
+V+Opt+3Sg:%<li K_TUQ ;
+V+Opt+3Sg:%<gili K_TUQ ;
LEXICON Opt_mood_itr_plural
+V+Opt+1Pl:%<lata K_TUQ_plur ;
+V+Opt+3Pl:%<lit K_TUQ_plur ;
+V+Opt+3Pl:%<gilit K_TUQ_plur ; !fra XIiPX_fleksiver 
+V+Opt+3Pl+Orth/Alt+Use/SpellNoSugg:%<lik K_TUQ_plur ;

LEXICON Cont_itr
+V+Cont:%<c2lu Cont_itr_pers_num ;
+V+Cont+1Du:%<c2lunuk K_plur ;
+V+ContNeg:%<n2a Cont_itr_pers_num ;
@U.Num.Sg@+V+ContNeg+2Sg:@U.Num.Sg@%<nak K ; !flex_iv

LEXICON IteCau_itr_pers_num
Cau_itr_pers_num ;
Cau_Con_itr_3p_pers_num ;

LEXICON Cau_itr_pers_num
< "@U.Num.Sg@" > Cau_itr_singular ;
< "@U.Num.Pl@" > Cau_itr_plural ;

LEXICON Cau_itr_singular
+1Sg:%<ma K ;
+2Sg:%<v2it K ;
+4Sg:%<mi K ;

LEXICON Cau_itr_plural
+1Pl:%<tta K_plur ;
+2Pl:%<ssi K_plur ;
+4Pl:%<mik K_plur ;

LEXICON Cau_Con_itr_3p_pers_num
@U.Num.Sg@+3Sg:@U.Num.Sg@%<t K ;
@U.Num.Pl@+3Pl:@U.Num.Pl@%<ta K_plur ;

LEXICON Con_itr_pers_num
< "@U.Num.Sg@" > Con_itr_singular ;
< "@U.Num.Pl@" > Con_itr_plural ;

LEXICON Con_itr_singular
+1Sg:%<ma K ;
+2Sg:%<it K ;
+4Sg:%<ni K ;

LEXICON Con_itr_plural
+1Pl:%<tta K_plur ;
+2Pl:%<ssi K_plur ;
+4Pl:%<nik K_plur ;

LEXICON Cont_itr_pers_num
< "@U.Num.Sg@" > Cont_itr_singular ;
< "@U.Num.Pl@" > Cont_itr_plural ;

LEXICON Cont_itr_singular
+1Sg:%<nga K ;
+2Sg:%<tit K ;
+4Sg:%<ni K ;

LEXICON Cont_itr_plural
+1Pl:%<ta K_plur ; 
+2Pl:%<si K_plur ;
+4Pl:%<tik K_plur ;

LEXICON verb_itr_pers_num
< "@U.Num.Sg@" > verb_itr_singular ;
< "@U.Num.Pl@" > verb_itr_plural ;

LEXICON verb_itr_singular
+1Sg:%<nga K ;
+2Sg:%<tit K ;
+3Sg:%<q K ;

LEXICON verb_itr_plural
+1Pl:%<gut K_plur ;
+2Pl:%<si K_plur ;
+3Pl:%<t K_plur ;

!###################################################!
!særegne former intransitive
!###################################################!

LEXICON XIgujoqX3 !!= * @CODE@ 
+V+Ind+1Sg:^VT%<ujunga K ;
+V+Ind+1Sg:%<langa K ; !sapiisertariaqanngikkilanga piss. 20241001 OD
+V+Ind+2Sg:^VT%<ujutit K ; !avinngannguaateqarujutit pissutigalugu Ondi 20240715
+V+Ind+3Sg:^VT%<ujoq K ;
+V+Ind+1Pl:^VT%<ujugut K ;
+V+Ind+3Pl:%<pput K_plur ;
+V+Int+3Sg:^VT%<uja K ;
+V+Int+3Pl:%<ppat K_plur ;
+V+Imp+2Sg:%<na K ; !sulilluarina, ajunngikkina
+V+Imp+1Pl:%<sa Krestr ; !unnusiuaaqatigiikkisa
+V+Imp+2Pl:%<si K_TUQ_plur ;
+V+Opt+3Sg:%<li K_TUQ ;
+V+Opt+3Pl:%<lit K_plur ;
+V+Opt+3Pl+Orth/Alt:%<lik K_plur ;
+V+Cont+4Pl:%<lluni K ; !liv 170127
+V+Cont+4Pl:%<llutik K_plur ; !liv 170127

LEXICON XImioqX2 !!= * @CODE@ narratologisk stil som i *nikutsinnguarsinnarmioq*
+V+Ind+1Sg:%<unga K ; ! Ondi 20240516 itermiunga pissutigalugu
+V+Ind+1Pl:%<ugut K ;
+V+Ind+3Pl:%<ut K ;
+V+Ind+3Sg:%<oq K ;
+V+Ind+3Sg:%<voq K ;
+V+Cau+1Sg:%<gama K ;
+V+Cau+4Sg:%<gami K ; !imaannaanngikkaluarmigami piss. 20240816
+V+Cau+4Pl:%<gamik K_plur ;
+V+Cau+1Pl:%<gatta K_plur ;
+V+ContNeg+4Sg:%<nani K ; !PL20231109 tilføjet. Formen fundet i ilivse tássa nunagssarse

!####################!
!# TRANSITIVE VERBS #!
!####################!

!##########################!
!# Modi transitive verber #!
!##########################!

LEXICON transitive_inflections
!# overordnede modi #!
@D.negation.ON@+V+Ind:@D.negation.ON@%<v2a Ind_verb_tr_pers_num ;
@R.negation.ON@+V+Ind:@R.negation.ON@^T%<la Ind_verb_tr_pers_num ;
@D.negation.ON@+V+Int:@D.negation.ON@%<v2i Int_verb_tr_pers_num ;
@R.negation.ON@+V+Int:@R.negation.ON@^T%<li Int_verb_tr_pers_num ;
Imp_Opt_verb_tr_mood ;
!# underordnede modi #!
@D.negation.ON@+V+Cau:@D.negation.ON@%<ga Cau_Con_verb_tr_pers_num ;
@R.negation.ON@+V+Cau:@R.negation.ON@%<na Cau_Con_verb_tr_pers_num ;
+V+Cau:%<c2ma Cau_Con_3PersSubj_verb_tr_pers_num ;
+V+IteCau:%<gaanga Cau_Con_verb_tr_pers_num ;
+V+IteCau:%<gaanga Cau_Con_3PersSubj_verb_tr_pers_num ;
+V+Con:%<gu Cau_Con_verb_tr_pers_num ;
+V+Con:%<c2pa Cau_Con_3PersSubj_verb_tr_pers_num ;
Cont_tr ;
+V+Cont+1Du+Gram/Refl:%<c2lunuk K_plur ; !er medtaget i oprindeligt transitivt leksikon
@D.schwa.ON@@D.utevv.ON@@D.utevvspeciel.ON@+V+ContNeg:@D.schwa.ON@@D.utevv.ON@@D.utevvspeciel.ON@%<c2n2a Cont_verb_tr_pers_num ;
@R.schwa.ON@+V+ContNeg:@R.schwa.ON@%<na Cont_verb_tr_pers_num ;
@R.utevv.ON@+V+ContNeg:@R.utevv.ON@%<na Cont_verb_tr_pers_num ;
@R.utevvspeciel.ON@+V+ContNeg:@R.utevvspeciel.ON@%<na Cont_verb_tr_pers_num ;
@U.ObjNum.Sg@+V+ContNeg+2SgO:@U.ObjNum.Sg@%<c2nak K ; !flex_tv
+V+Par:%<gi2 Par_verb_tr_pers_num ;

LEXICON Imp_Opt_verb_tr_mood
@U.imp.ON@+V+Imp:@U.imp.ON@0 Imp_verb_tr ;
@D.negation.ON@+V+Opt:@D.negation.ON@%<la Opt_verb_tr_pers_num ;
@D.negation.ON@+V+Opt:@D.negation.ON@%<li Opt_3PersSubj_verb_tr_pers_num ;
@R.negation.ON@+V+Opt:@R.negation.ON@%<gila Opt_verb_tr_pers_num ;
@R.negation.ON@+V+Opt:@R.negation.ON@%<gili Opt_3PersSubj_verb_tr_pers_num ;
@P.schwa.ON@+V+Opt:@P.schwa.ON@%<gila Opt_verb_tr_pers_num ;

!#######################################!
!# Person og numerus transitive verber #!
!#######################################!

LEXICON Ind_verb_tr_pers_num
< "@U.ObjNum.Sg@" > Ind_verb_tr_singular_Obj ;
< "@U.ObjNum.Pl@" > Ind_verb_tr_plural_Obj ;

LEXICON Ind_verb_tr_singular_Obj
< "@U.SubjNum.Sg@" > Ind_verb_tr_Sg_Subj_Sg_Obj ;
< "@U.SubjNum.Pl@" > Ind_verb_tr_Pl_Subj_Sg_Obj ;

LEXICON Ind_verb_tr_Sg_Subj_Sg_Obj
@D.ssa.vv@+1Sg+2SgO:@D.ssa.vv@%<kkit K_VOK ;
@R.ssa.vv@+1Sg+2SgO+Orth/Alt+Use/SpellNoSugg:@R.ssa.vv@%<kkit K_VOK ;
+1Sg+2SgO+Orth/Alt+Use/SpellNoSugg:%<git K_VOK ;
+1Sg+3SgO:%<ra Ind_verb_tr_clitics ; !K
+2Sg+1SgO:%<rma Ind_verb_tr_clitics ; !K
+2Sg+3SgO:%<t^ Ind_verb_tr_clitics ; !K caret ^brugt her for at blokere for gemineringregelen ved intransitiv indikativ 3Pl efter negation, som har samme form som dette
+3Sg+1SgO:%<anga Ind_verb_tr_clitics ; !K
+3Sg+2SgO:%<atit Ind_verb_tr_clitics ; !K
+3Sg+3SgO:%<a Ind_verb_tr_clitics ; !K
+3Sg+4SgO+Orth/Arch+Use/SpellNoSugg:%<ani K ;

LEXICON Ind_verb_tr_Pl_Subj_Sg_Obj
+1Pl+2SgO:%<tsigit Ind_verb_tr_clitics ; !K
+1Pl+3SgO:%<rput Ind_verb_tr_clitics ; !K
+2Pl+1SgO:%<ssinga Ind_verb_tr_clitics ; !K
+2Pl+3SgO:%<rsi Ind_verb_tr_clitics ; !K
+3Pl+1SgO:%<annga Ind_verb_tr_clitics ; !K
+3Pl+2SgO:%<atsit Ind_verb_tr_clitics ; !K
+3Pl+3SgO:%<at Ind_verb_tr_clitics ; !K

LEXICON Ind_verb_tr_plural_Obj
< "@U.SubjNum.Sg@" > Ind_verb_tr_Sg_Subj_Pl_Obj ;
< "@U.SubjNum.Pl@" > Ind_verb_tr_Pl_Subj_Pl_Obj ;

LEXICON Ind_verb_tr_Sg_Subj_Pl_Obj
+1Sg+2PlO:%<ssi Ind_verb_tr_clitics ; !K_plur
+1Sg+3PlO:%<kka Ind_verb_tr_clitics ; !K_plur
+2Sg+1PlO:%<tsigut Ind_verb_tr_clitics ; !K_plur
+2Sg+3PlO:%<tit Ind_verb_tr_clitics ; !K_plur
+3Sg+1PlO:%<atigut Ind_verb_tr_clitics ; !K_plur
+3Sg+2PlO:%<asi Ind_verb_tr_clitics ; !K_plur
+3Sg+3PlO:%<i Ind_verb_tr_clitics ; !K_plur

LEXICON Ind_verb_tr_Pl_Subj_Pl_Obj
+1Pl+2PlO:%<ssi Ind_verb_tr_clitics ; !K_plur
+1Pl+3PlO:%<vut Ind_verb_tr_clitics ; !K_plur
+1Pl+3PlO:%<gut Ind_verb_tr_clitics ; !K_plur
+2Pl+1PlO:%<tsigut Ind_verb_tr_clitics ; !K_plur
+2Pl+3PlO:%<si Ind_verb_tr_clitics ; !K_plur
+3Pl+1PlO:%<atigut Ind_verb_tr_clitics ; !K_plur
+3Pl+2PlO:%<asi Ind_verb_tr_clitics ; !K_plur
+3Pl+3PlO:%<at Ind_verb_tr_clitics ; !K_plur
@C.ssa@+3Pl+3PlO+Orth/Alt+Use/SpellNoSugg:@C.ssa@%<i K_plur ;

LEXICON Ind_verb_tr_clitics
< "@C.utevv@" "@C.SubjNum@" "@D.ssa.vv@" "@U.ObjNum.Sg@" > K ;
< "@C.utevv@" "@C.SubjNum@" "@D.ssa.vv@" "@U.ObjNum.Pl@" > K_plur ;
@C.utevv@@C.SubjNum@@R.ssa.vv@@U.ObjNum.Sg@+Orth/Alt+Use/SpellNoSugg:@C.utevv@@C.SubjNum@@R.ssa.vv@@U.ObjNum.Sg@0 K ;
@C.utevv@@C.SubjNum@@R.ssa.vv@@U.ObjNum.Pl@+Orth/Alt+Use/SpellNoSugg:@C.utevv@@C.SubjNum@@R.ssa.vv@@U.ObjNum.Pl@0 K_plur ;

LEXICON Int_verb_tr_pers_num
< "@U.ObjNum.Sg@" > Int_verb_tr_singular_Obj ;
< "@U.ObjNum.Pl@" > Int_verb_tr_plural_Obj ;

LEXICON Int_verb_tr_singular_Obj
< "@U.SubjNum.Sg@" > Int_verb_tr_Sg_Subj_Sg_Obj ;
< "@U.SubjNum.Pl@" > Int_verb_tr_Pl_Subj_Sg_Obj ;

LEXICON Int_verb_tr_Sg_Subj_Sg_Obj
+2Sg+1SgO:%<nga K ;
+2Sg+3SgO:%<uk K ;

LEXICON Int_verb_tr_Pl_Subj_Sg_Obj
+2Pl+1SgO:%<singa K ;
+2Pl+3SgO:%<siuk K ;

LEXICON Int_verb_tr_plural_Obj
< "@U.SubjNum.Sg@" > Int_verb_tr_Sg_Subj_Pl_Obj ;
< "@U.SubjNum.Pl@" > Int_verb_tr_Pl_Subj_Pl_Obj ;

LEXICON Int_verb_tr_Sg_Subj_Pl_Obj
+2Sg+1PlO:%<sigut K_plur ;
+2Sg+3PlO:%<git K_plur ;

LEXICON Int_verb_tr_Pl_Subj_Pl_Obj
+2Pl+1PlO:%<sigut K_plur ;
+2Pl+3PlO+Orth/Arch+Use/SpellNoSugg:%<sigik K_plur ;
+2Pl+3PlO:%<sigit K_plur ;

LEXICON Imp_verb_tr
< "@U.ObjNum.Sg@" > Imp_verb_tr_singular_Obj ;
< "@U.ObjNum.Pl@" > Imp_verb_tr_plural_Obj ;

LEXICON Imp_verb_tr_singular_Obj
< "@U.SubjNum.Sg@" > Imp_verb_tr_Sg_Subj_Sg_Obj ;
< "@U.SubjNum.Pl@" > Imp_verb_tr_Pl_Subj_Sg_Obj ;

LEXICON Imp_verb_tr_Sg_Subj_Sg_Obj
@D.utevv.ON@+2Sg+1SgO:@D.utevv.ON@^T%<nnga K_TUQ ;
@R.utevv.ON@+2Sg+1SgO:@R.utevv.ON@^T%<tinnga K_TUQ ;
@R.utevv.ON@+2Sg+1SgO+Orth/Arch+Use/SpellNoSugg:@R.utevv.ON@^T%<nnga K_TUQ ;
+2Sg+3SgO:%<g2uk K_TUQ ;
+2Sg+3SgO:%<giuk K_TUQ ; !se +GI nassiukkiuk
+2Sg+3SgO+Gram/ImpPos:%<g2uk K_TUQ ;
+2Sg+3SgO+Gram/ImpNeg:%<nagu K_TUQ ;

LEXICON Imp_verb_tr_Pl_Subj_Sg_Obj
+1Pl+3SgO:%<tigu K_TUQ ;
+2Pl+1SgO:%<singa K_TUQ ;
+2Pl+3SgO:%<siuk K_TUQ ;
+2Pl+3SgO:%<gisiuk K_TUQ ; ! se +GI atorluarisiuk

LEXICON Imp_verb_tr_plural_Obj
< "@U.SubjNum.Sg@" > Imp_verb_tr_Sg_Subj_Pl_Obj ;
< "@U.SubjNum.Pl@" > Imp_verb_tr_Pl_Subj_Pl_Obj ;

LEXICON Imp_verb_tr_Sg_Subj_Pl_Obj
+2Sg+1PlO:%<tigut K_TUQ_plur ;
@D.utevv.ON@+2Sg+3PlO:@D.utevv.ON@^T%<kkit K_TUQ_plur ;
@R.utevv.ON@+2Sg+3PlO:@R.utevv.ON@^T%<tikkit K_TUQ_plur ;

LEXICON Imp_verb_tr_Pl_Subj_Pl_Obj
+1Pl+3PlO+Orth/Arch+Use/SpellNoSugg:%<tigik K_TUQ_plur ;
+1Pl+3PlO:%<tigit K_TUQ_plur ;
+2Pl+1PlO:%<tigut K_TUQ_plur ;
+2Pl+3PlO+Orth/Arch+Use/SpellNoSugg:%<sigik K_TUQ_plur ;
+2Pl+3PlO:%<sigit K_TUQ_plur ;

LEXICON Opt_verb_tr_pers_num
< "@U.ObjNum.Sg@" > Opt_verb_tr_singular_Obj ;
< "@U.ObjNum.Pl@" > Opt_verb_tr_plural_Obj ;

LEXICON Opt_verb_tr_singular_Obj
< "@U.SubjNum.Sg@" > Opt_verb_tr_Sg_Subj_Sg_Obj ;
< "@U.SubjNum.Pl@" > Opt_verb_tr_Pl_Subj_Sg_Obj ;

LEXICON Opt_verb_tr_Sg_Subj_Sg_Obj
+1Sg+2SgO:%<kkit K_TUQ ;
+1Sg+3SgO:%<ra K_TUQ ;

LEXICON Opt_verb_tr_Pl_Subj_Sg_Obj
+1Pl+2SgO:%<tsigit K_TUQ ;
